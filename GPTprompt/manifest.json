{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.0.7",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://*.claude.ai/*",
    "https://grok.com/*",
    "https://*.grok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://*.claude.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "variable-utils.js",
        "panel-utils.js",
        "storage.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://*.claude.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
      ]
    }
  ],
  "default_locale": "zh_TW"
}
